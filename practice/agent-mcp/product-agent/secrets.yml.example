# 이 파일을 secrets.yml 로 복사하고 키를 채우면 된다.
#
#   cp secrets.yml.example secrets.yml
#
# secrets.yml 은 .gitignore 에 등록되어 있어 커밋되지 않는다.
# 활성 프로파일 쪽 키만 있으면 되고, 나머지 줄은 지우거나 그대로 둬도 된다.
#
# 환경변수(OPENAI_API_KEY / ANTHROPIC_API_KEY)를 export 해도 동작하며,
# 둘 다 있으면 환경변수가 이 파일보다 우선한다.

OPENAI_API_KEY: "sk-여기에-키를-넣으세요"
ANTHROPIC_API_KEY: "sk-ant-여기에-키를-넣으세요"
